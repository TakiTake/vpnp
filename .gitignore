# VPN configs contain certificates/keys — never commit
config/*.ovpn

# local environment overrides
.env

# per-user VPN DNS suffixes / container access rules (contain internal
# hostnames and network layout)
config/vpn.dns
config/vpn.access

# vpnp runtime state (pidfile, daemon log)
.run/

# built binary if compiled into the repo, and Go build/test artifacts
/vpnp
*.test
*.out

# agent worktrees (transient) and personal Claude Code settings.
# .claude/skills/ IS tracked; everything else under .claude/ is not.
.claude/*
!.claude/skills/

# obsolete build artifacts from earlier incarnations
kernel/
