# Copy to .env and adjust. Used by `vpnp status`.
# A VPN-private URL that only responds through the tunnel — proves end-to-end health.
VPN_TEST_URL=https://internal.example.corp/healthz

# Subnet that gets source-NAT'd onto the tunnel so apple/container guests
# reach the VPN. Default: 192.168.64.0/24 (vmnet). Set to "off" to disable.
#CONTAINER_NAT_SUBNET=192.168.64.0/24
